<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 本地 feed：框架 NoLicense 包本机构建的 nupkg（内网不可达时用） -->
    <add key="saibo-local" value="D:\projects\saibo\framework\local-feed" />
    <!-- saibo 私有 BaGet：托管 Sb.Framework.* + Mirror 透传 nuget.org 公共包。优先内网 -->
    <add key="saibo-baget" value="https://nuget.saibo.club/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

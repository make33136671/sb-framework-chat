<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sb.Framework.Chat.Telegram.MtProto</RootNamespace>
    <AssemblyName>Sb.Framework.Chat.Telegram.MtProto</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId Condition="'$(DisableLicense)' != 'true'">Sb.Framework.Chat.Telegram.MtProto</PackageId>
    <PackageId Condition="'$(DisableLicense)' == 'true'">Sb.Framework.Chat.Telegram.MtProto.NoLicense</PackageId>
    <Version>0.1.0-preview.33</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Sb Framework</Authors>
    <Description>SB Framework Chat 个人号通道适配（MTProto，基于 WTelegramClient）：会话管理/认证/Update 推送/历史消息/媒体下载/资料成员在线状态扩展。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sb.Framework.Chat" Version="0.1.0-preview.29" />
    <PackageReference Include="WTelegramClient" Version="4.2.1" />
  </ItemGroup>

</Project>

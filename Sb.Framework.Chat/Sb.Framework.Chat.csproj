<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sb.Framework.Chat</RootNamespace>
    <AssemblyName>Sb.Framework.Chat</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId Condition="'$(DisableLicense)' != 'true'">Sb.Framework.Chat</PackageId>
    <PackageId Condition="'$(DisableLicense)' == 'true'">Sb.Framework.Chat.NoLicense</PackageId>
    <Version>0.1.0-preview.29</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>Sb Framework</Authors>
    <Description>SB Framework Chat 统一核心：双通道（Bot/个人号）消息模型、MessageHandler、会话上下文、账号容器、存储。设计参考盛派微信 SDK。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 本地源码引用 sb-framework（dotnet pack 自动将 ProjectReference 转为对应版本的包依赖，发布能力不受影响）。
         平台 D33：本地联调优先，避免与本地 ProjectReference 消费方产生同名 DLL 冲突（CS1704）。 -->
    <ProjectReference Include="..\..\sb-framework\SB.Framework.Core\SB.Framework.Core.csproj" />
    <ProjectReference Include="..\..\sb-framework\SB.Framework.Models\SB.Framework.Models.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project>

  <!-- 公共 NuGet 元数据（nuget.org）；子项目 csproj 中的同名属性优先级更高，可覆盖 -->
  <PropertyGroup>
    <Authors>SB Framework</Authors>
    <Company>SB Framework</Company>
    <Copyright>Copyright (c) 2026 SB Framework</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/make33136671/sb-framework-chat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/make33136671/sb-framework-chat.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
